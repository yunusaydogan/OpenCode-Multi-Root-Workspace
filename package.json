{
  "name": "opencode-multi-root-workspace",
  "version": "0.1.0",
  "description": "Session-scoped multi-repository workspaces for OpenCode Desktop 2.2.5",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "bin": {
    "oc-workspace": "./src/cli.mjs"
  },
  "files": [
    "src",
    "dist",
    "examples",
    "docs",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check",
    "test:live": "node test/live-smoke.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opencode/client": "2.2.5",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "keywords": [
    "opencode",
    "plugin",
    "workspace",
    "multi-root",
    "git"
  ]
}
