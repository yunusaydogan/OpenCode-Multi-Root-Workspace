{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCode Multi-Root Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "roots"],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "allowFileWrites": {
      "type": "boolean",
      "default": false
    },
    "allowGitWrites": {
      "type": "boolean",
      "default": false
    }
  }
}
